rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist — maps a signed-in Firebase Auth uid to the venues
    // they are authorized to manage. Written only via the Admin SDK
    // (see scripts/create-admin.mjs); never writable from the client.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed only via Admin SDK / scripts/create-admin.mjs
    }

    // Venue Settings (public config)
    match /venue_settings/{venueId} {
      allow read: if true;
      allow write: if false; // Only admins via Server Actions
    }

    // Venue Secrets (tokens)
    match /venue_secrets/{venueId} {
      allow read, write: if false; // ONLY accessible via Firebase Admin SDK
    }

    // Venue Queues
    match /venue_queues/{venueId} {
      allow read: if true;
      
      match /queued_songs/{songId} {
        // Anyone can see the queue
        allow read: if true;

        // Any authenticated user can request a song
        allow create: if request.auth != null
                      && request.resource.data.upvoteCount == 1
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.status in ['pending', 'approved']
                      && request.resource.data.voters == [request.auth.uid]
                      && request.resource.data.title.size() < 200
                      && request.resource.data.artist.size() < 200;

        // Any authenticated user can upvote — exactly once per user.
        // Every field other than upvoteCount/voters must stay pinned to its
        // current value, so a patron can't sneak a status change (moderation
        // bypass) into the same write as their upvote.
        // `resource.data.get('voters', [])` tolerates documents written before
        // this field existed, so pre-migration songs aren't permanently locked
        // out of upvoting.
        allow update: if request.auth != null
                      && !(request.auth.uid in resource.data.get('voters', []))
                      && request.resource.data.upvoteCount == resource.data.upvoteCount + 1
                      && request.resource.data.voters == resource.data.get('voters', []).concat([request.auth.uid])
                      && request.resource.data.title == resource.data.title
                      && request.resource.data.artist == resource.data.artist
                      && request.resource.data.albumArt == resource.data.albumArt
                      && request.resource.data.requestedBy == resource.data.requestedBy
                      && request.resource.data.status == resource.data.status
                      && request.resource.data.spotifyTrackId == resource.data.spotifyTrackId;
      }
    }
  }
}
