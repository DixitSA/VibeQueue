# ─── VibeQueue — Environment Variables ───────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
#
# .env.local is already in .gitignore by default in Next.js projects.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase (Project Settings → Your Apps → SDK setup and configuration) ─────
# All NEXT_PUBLIC_ vars are safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Spotify (developer.spotify.com → Your App → Settings) ────────────────────
# These are SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix.
# Used by the Client Credentials flow in lib/spotify.ts.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Admin / OAuth (developer.spotify.com → Your App → Redirect URIs) ─────────
# Add this URI in your Spotify app dashboard under Redirect URIs.
# Change the domain when deploying to production.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# The Firestore document ID for the venue this admin panel controls.
NEXT_PUBLIC_ADMIN_VENUE_ID=CHARLOTTE_TEST

# PIN gate for the admin dashboard UI. NEXT_PUBLIC_ means this is bundled into
# client JS and readable by anyone — see RELEASE_PLAN.md P0 #2 for why this
# needs to be replaced with real server-side admin auth before launch.
NEXT_PUBLIC_ADMIN_PIN=1234

# ── Firebase Admin SDK (Project Settings → Service Accounts → Generate key) ───
# Server-side only — used by lib/firebaseAdmin.ts for privileged Firestore/
# Spotify-token operations. Never expose these with a NEXT_PUBLIC_ prefix.
FIREBASE_CLIENT_EMAIL=
# Paste the private key from the downloaded service account JSON. Keep the
# literal \n escape sequences (they're unescaped to real newlines at runtime).
FIREBASE_PRIVATE_KEY=
